# openai | gemini | vertex | ollama | custom
LLM_PROVIDER=openai

# Examples:
# openai -> gpt-4o-mini
# gemini -> gemini-1.5-flash (prefix gemini/ will be added automatically)
# vertex -> gemini-1.5-pro (prefix vertex_ai/ will be added automatically)
# ollama -> ollama_chat/llama3.1
LLM_MODEL=gpt-4o-mini

# Required for all providers except vertex (vertex uses ADC credentials)
LLM_API_KEY=your_api_key_here

# Optional custom base URL (for proxy/self-hosted providers)
LLM_API_BASE=
